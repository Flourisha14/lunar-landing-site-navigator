# ==========================================
# Lunar Landing Site Navigator
# Local Development Configuration
# ==========================================

# Application environment
LUNAR_ENV=development

# Scientific data root
# Paths are relative to the repository root.
LUNAR_DATA_DIR=./data

# NASA SPICE kernel directory
LUNAR_SPICE_KERNEL_DIR=./data/kernels

# Lunar Digital Elevation Model directory
LUNAR_DEM_DIR=./data/dem

# Lunar imagery directory
LUNAR_IMAGERY_DIR=./data/imagery

# Future FastAPI development server
LUNAR_API_HOST=127.0.0.1
LUNAR_API_PORT=8000