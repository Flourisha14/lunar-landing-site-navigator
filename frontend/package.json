{
    "name": "lunasolum-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host localhost",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host localhost",
        "typecheck": "tsc -b",
        "test": "vitest run src",
        "lint": "eslint src",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "cesium": "^1.147.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "@types/node": "^22.15.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^10.15.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.72.2",
        "vite": "^7.1.0",
        "vite-plugin-cesium": "^1.2.23",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "11.0.1"
        }
    }
}
